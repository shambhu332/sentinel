# ── LLM Providers (local-first priority) ───────────────────────────────────
# Local vLLM / TensorRT-LLM endpoint (OpenAI-compatible). Takes priority over cloud.
# Example: http://localhost:8080 (vLLM) or http://localhost:8000/v1 (TensorRT)
SENTINEL_LOCAL_LLM_URL=
SENTINEL_LOCAL_LLM_MODEL=local-model

# Cloud LLM fallbacks (optional — local inference runs without these)
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
GITHUB_TOKEN=

# Ollama (always-on local fallback — runs on CPU if no GPU)
OLLAMA_HOST=http://localhost:11434

# ── Infrastructure ──────────────────────────────────────────────────────────
# PostgreSQL — T1 memory (events, findings, audit log)
DATABASE_URL=postgresql://sentinel_service:sentineldev@localhost:5432/sentinel

# Redis — JWT revocation, LLM cache, rate limiting, RQ job queue
REDIS_URL=redis://localhost:6379/0

# Qdrant — T2 semantic vector store
QDRANT_URL=http://localhost:6333

# Neo4j — T3 exploit chain graph
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=sentineldev

# ── SENTINEL Runtime ────────────────────────────────────────────────────────
SENTINEL_LOG_LEVEL=INFO
SENTINEL_WORKSPACE=./workspace
SENTINEL_MAX_APK_SIZE_MB=500
SENTINEL_SCAN_TIMEOUT_SECONDS=1800

# JWT — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SENTINEL_JWT_SECRET=change-this-to-a-long-random-value

# Set to true ONLY for local dev (skips JWT validation)
SENTINEL_DEV_AUTH_BYPASS=false

SENTINEL_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,null

# ── At-Rest Encryption (Phase 1.4) ─────────────────────────────────────────
# Generate with: python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# Leave empty to disable encryption (dev / local mode)
SENTINEL_MASTER_KEY=
SENTINEL_ENCRYPT_WORKSPACES=false
SENTINEL_SCAN_RETENTION_DAYS=30
SENTINEL_JANITOR_INTERVAL_SECONDS=3600
