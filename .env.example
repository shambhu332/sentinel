# Cerebras - get free key at https://cloud.cerebras.ai
CEREBRAS_API_KEY=your-cerebras-key-here

# Optional fallback providers (for router failover)
GROQ_API_KEY=
MISTRAL_API_KEY=
GITHUB_TOKEN=

# Ollama local LLM (leave as-is)
OLLAMA_HOST=http://localhost:11434

# SENTINEL runtime
SENTINEL_LOG_LEVEL=INFO
SENTINEL_WORKSPACE=./workspace
SENTINEL_MAX_APK_SIZE_MB=500
SENTINEL_SCAN_TIMEOUT_SECONDS=1800
SENTINEL_JWT_SECRET=change-this-to-a-long-random-value
SENTINEL_DEV_AUTH_BYPASS=false
SENTINEL_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,null
